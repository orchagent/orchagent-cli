{
  "name": "@orchagent/cli",
  "version": "0.3.99",
  "description": "Command-line interface for orchagent — deploy and run AI agents for your team",
  "license": "MIT",
  "author": "orchagent <hello@orchagent.io>",
  "homepage": "https://orchagent.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/orchagent/orchagent-cli.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/orchagent/orchagent/issues"
  },
  "keywords": [
    "orchagent",
    "ai",
    "agents",
    "cli",
    "marketplace",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "orch": "dist/index.js",
    "orchagent": "dist/index.js"
  },
  "files": [
    "dist",
    "src/resources"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "vitest run && vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sentry/node": "^9.3.0",
    "archiver": "^7.0.0",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "fast-deep-equal": "^3.1.3",
    "open": "^8.4.2",
    "ora": "^9.1.0",
    "posthog-node": "^4.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/node": "^20.14.2",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
